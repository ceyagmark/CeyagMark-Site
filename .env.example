# Copy to .env.local for real Supabase use. Unset entirely for local dev with
# CEYAG_DEV_DB=1 (PGlite, no credentials needed).

# --- Data source selector ---
# Set to 1 for local/dev (PGlite, in-memory, no credentials). Must NEVER be
# set to 1 in a production build — env.ts throws if it is.
CEYAG_DEV_DB=1

# --- Supabase (required when CEYAG_DEV_DB is unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications ---
# Unset -> ConsoleNotifier (prints, logs "skipped"). Set both to send real email.
NOTIFY_FROM_EMAIL=
RESEND_API_KEY=

# --- Lead sink (Hub adapter) ---
# Unset -> logs "skipped". The Hub has no credentials tonight (see ADR-001).
HUB_INTAKE_URL=

# --- Admin ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Seed fallback (already-public business contact, see supabase/seed.sql) ---
SEED_OWNER_EMAIL=growth@ceyagmark.com

# --- Analytics (Slice 5) ---
# GTM-T7ZVSV73 is the real container already live on ceyagmark.com (it just
# fires zero tags there — that's the audit finding this rebuild exists to
# fix). Keep this ID; only change it if the container itself is ever
# recreated. GA4/Meta Pixel/Clarity have no real IDs anywhere in this
# workspace — leave them unset until Shashika creates those accounts. Each
# is independently env-gated: unset -> that script never loads, no fallback
# ID, no placeholder value.
NEXT_PUBLIC_GTM_ID=GTM-T7ZVSV73
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
