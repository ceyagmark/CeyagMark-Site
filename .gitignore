# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the real, maintained reference for every var
# this app reads (see DEPLOY.md); it belongs in git. Everything else here
# holds real secrets or a real analytics ID and stays local-only.
.env*
!.env.example

# vercel
.vercel

# runtime-generated lead sink pipeline log (data/hub-pipeline-log.jsonl)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts
